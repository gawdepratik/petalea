# Postgres connection string (from Neon.tech project settings)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Comma-separated list of email addresses allowed to log into the admin panel
ADMIN_EMAILS=orders@petalea.in,akanksha.nikam@petalea.in

# Secret used to sign admin session JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=https://gawdepratik.github.io,https://petalea.in

# --- Outbound email (M365 relay connector) ---
# This connector only accepts mail from an IP address that has been
# allow-listed in Exchange Admin Center > Mail flow > Connectors.
# It does NOT use a username/password.
SMTP_HOST=petalea-in.mail.protection.outlook.com
SMTP_PORT=25
SMTP_FROM=no-reply@petalea.in

# Set to "true" to skip actually sending email and just log OTP codes/order
# notifications to the console instead. Use this for local development,
# since the relay connector will reject mail from a non-allow-listed IP
# (like your laptop) anyway.
EMAIL_DEV_MODE=true

# Set to "false" only for local HTTP development (SameSite=None cookies
# require Secure, which requires HTTPS). Leave unset/"true" in production.
COOKIE_SECURE=true

PORT=4000

# Email admins the first time a purchase drops a tracked product's stock
# (only products with a stock_quantity set - not unlimited/untracked ones)
# to this level or below. Only fires once per crossing, not on every sale
# after that. Defaults to 2 if unset.
LOW_STOCK_THRESHOLD=2

# --- Google Analytics Data API (for the admin Analytics tab) ---
# Property ID from GA Admin > Property Settings (numeric, not the G-XXXX
# measurement ID). Service account credentials come from a Google Cloud
# service account JSON key, granted Viewer access on the GA property.
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_EMAIL=
GA_SERVICE_ACCOUNT_PRIVATE_KEY=
